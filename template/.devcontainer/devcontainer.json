// Stream Deck Plugin Development Container
// https://docs.elgato.com/streamdeck/sdk/introduction/getting-started/
{
  "name": "{{ project_name }}",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Forward the property-inspector debug port (remote debugger)
  "forwardPorts": [23654],

  "customizations": {
    "vscode": {
      "extensions": [
        // Linting & formatting
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        // TypeScript
        "ms-vscode.vscode-typescript-next",
        // GitHub Copilot
        "GitHub.copilot",
        "GitHub.copilot-chat",
        // Others
        "vivaxy.vscode-conventional-commits",
        "task.vscode-task",
        "planet57.vscode-beads"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.enable": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.preferences.importModuleSpecifier": "relative",
        "files.associations": {
          "manifest.json": "json"
        },
        "files.exclude": {
          "**/node_modules": true,
          "**/.git": true,
          "{{ plugin_uuid }}.sdPlugin/bin": true,
          "{{ plugin_uuid }}.sdPlugin/logs": true
        }
      }
    }
  },

  "postCreateCommand": "/workspace/.devcontainer/post-create.sh",
  "postStartCommand": "/workspace/.devcontainer/post-start.sh",

  "remoteUser": "vscode"
}
