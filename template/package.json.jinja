{
	"name": "{{ repo_name }}",
	"version": "0.1.0",
	"description": "{{ description }}",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart {{ plugin_uuid }}\"",
		"lint": "eslint --max-warnings 0",
		"lint:fix": "eslint --fix",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"pack": "streamdeck pack {{ plugin_uuid }}.sdPlugin"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.0.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.6.0",
		"@elgato/eslint-config": "^1.0.0",
		"@elgato/prettier-config": "^1.0.0",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.0",
		"@rollup/plugin-typescript": "^12.0.0",
		"rollup": "^4.0.0",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0"
	},
	"prettier": "@elgato/prettier-config"{% if license == 'MIT' %},
	"license": "MIT"{% endif %}
}
